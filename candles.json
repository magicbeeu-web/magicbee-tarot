{
 "candles": {
  "火熱撩慾": {
   "cta": "想讓對方的心為你升溫、主動靠近，可以點一盞火熱撩慾蠟燭，點燃你們之間的吸引力。",
   "url": "https://line.me/R/oaMessage/@041giocs/?text=%E6%88%91%E6%83%B3%E8%B2%B7%E3%80%8C%E7%81%AB%E7%86%B1%E6%92%A9%E6%85%BE%E3%80%8D%E8%A0%9F%E7%87%AD"
  },
  "戀情長久": {
   "cta": "想讓這段感情穩穩走下去，可以點一盞戀情長久蠟燭，把你們的心牢牢繫在一起。",
   "url": "https://line.me/R/oaMessage/@041giocs/?text=%E6%88%91%E6%83%B3%E8%B2%B7%E3%80%8C%E6%88%80%E6%83%85%E9%95%B7%E4%B9%85%E3%80%8D%E8%A0%9F%E7%87%AD"
  },
  "幸運隨行": {
   "cta": "想讓好運加速到來，可以點一盞幸運隨行蠟燭，讓好運每天跟著你走。",
   "url": "https://line.me/R/oaMessage/@041giocs/?text=%E6%88%91%E6%83%B3%E8%B2%B7%E3%80%8C%E5%B9%B8%E9%81%8B%E9%9A%A8%E8%A1%8C%E3%80%8D%E8%A0%9F%E7%87%AD"
  },
  "清心解惡": {
   "cta": "想把身邊不好的能量和小人一次驅散，可以點一盞清心解惡蠟燭，替你斬斷負能量，把好運重新迎回來。",
   "url": "https://line.me/R/oaMessage/@041giocs/?text=%E6%88%91%E6%83%B3%E8%B2%B7%E3%80%8C%E6%B8%85%E5%BF%83%E8%A7%A3%E6%83%A1%E3%80%8D%E8%A0%9F%E7%87%AD"
  },
  "財運豐收": {
   "cta": "想讓財運加速進門，可以點一盞財運豐收蠟燭，把屬於你的錢財穩穩收進口袋。",
   "url": "https://line.me/R/oaMessage/@041giocs/?text=%E6%88%91%E6%83%B3%E8%B2%B7%E3%80%8C%E8%B2%A1%E9%81%8B%E8%B1%90%E6%94%B6%E3%80%8D%E8%A0%9F%E7%87%AD"
  },
  "貴人常駐": {
   "cta": "想讓貴人主動出現、出手幫你，可以點一盞貴人常駐蠟燭，讓貴人一路守在你身邊。",
   "url": "https://line.me/R/oaMessage/@041giocs/?text=%E6%88%91%E6%83%B3%E8%B2%B7%E3%80%8C%E8%B2%B4%E4%BA%BA%E5%B8%B8%E9%A7%90%E3%80%8D%E8%A0%9F%E7%87%AD"
  },
  "願力加速": {
   "cta": "想讓心裡的願望更快成真，可以點一盞願力加速蠟燭，替你的願望注入強大的能量。",
   "url": "https://line.me/R/oaMessage/@041giocs/?text=%E6%88%91%E6%83%B3%E8%B2%B7%E3%80%8C%E9%A1%98%E5%8A%9B%E5%8A%A0%E9%80%9F%E3%80%8D%E8%A0%9F%E7%87%AD"
